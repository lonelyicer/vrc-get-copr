# SPDX-License-Identifier: MPL-2.0
#
# COPR packaging for the vrc-get command line client.
#
# License note: the v1.9.3 release tarball packaged here is licensed under
# MIT.  Upstream switched to MPL-2.0 on master after that release; when
# packaging a newer release, update the License tag accordingly.
#
# Sources are fetched from the upstream release tag archives:
#   https://github.com/vrc-get/vrc-get/archive/refs/tags/v1.9.3.tar.gz

%global debug_package %{nil}
%global cargo_target_dir %{_builddir}/target-%{name}

Name:           vrc-get-cli
Version:        1.9.3
Release:        1%{?dist}
Summary:        Open-source command-line client for the VRChat Package Manager

License:        MIT
URL:            https://github.com/vrc-get/vrc-get
Source0:        https://github.com/vrc-get/vrc-get/archive/refs/tags/v%{version}.tar.gz#/vrc-get-%{version}.tar.gz

BuildRequires:  cargo
BuildRequires:  rust
BuildRequires:  gcc
BuildRequires:  help2man

Provides:       vrc-get = %{version}-%{release}

%description
vrc-get is a fast, open-source command-line client for the VRChat Package
Manager (VPM).  It can install and manage VPM packages, resolve dependencies,
and manage VRChat projects from the terminal.

%prep
%setup -q -n vrc-get-%{version}

%build
export CARGO_HOME=%{_builddir}/cargo-home
export CARGO_TARGET_DIR=%{cargo_target_dir}
export CCACHE_DIR=%{_builddir}/ccache
cargo build --release --locked -p vrc-get

%install
install -Dpm 0755 %{cargo_target_dir}/release/vrc-get %{buildroot}%{_bindir}/vrc-get

install -d %{buildroot}%{_mandir}/man1
help2man --no-info --section=1 \
    --name='Command-line client for the VRChat Package Manager' \
    %{cargo_target_dir}/release/vrc-get > %{buildroot}%{_mandir}/man1/vrc-get.1

# Shell completions generated by the freshly built binary.
install -d %{buildroot}%{_datadir}/bash-completion/completions
%{cargo_target_dir}/release/vrc-get completion bash > %{buildroot}%{_datadir}/bash-completion/completions/vrc-get
install -d %{buildroot}%{_datadir}/zsh/site-functions
%{cargo_target_dir}/release/vrc-get completion zsh > %{buildroot}%{_datadir}/zsh/site-functions/_vrc-get
install -d %{buildroot}%{_datadir}/fish/vendor_completions.d
%{cargo_target_dir}/release/vrc-get completion fish > %{buildroot}%{_datadir}/fish/vendor_completions.d/vrc-get.fish

%check
%{cargo_target_dir}/release/vrc-get --version

%files
%license LICENSE
%doc README.md CHANGELOG.md
%{_bindir}/vrc-get
%{_mandir}/man1/vrc-get.1*
%{_datadir}/bash-completion/completions/vrc-get
%{_datadir}/zsh/site-functions/_vrc-get
%{_datadir}/fish/vendor_completions.d/vrc-get.fish

%changelog
